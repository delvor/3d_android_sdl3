<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="16dp">

    <Button
        android:id="@+id/launchButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/launch_3d_maze_activity_opengles_3_0" />
    <Button
        android:id="@+id/button_matrix"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/launch_matrix_screensaver_sdl3" />
    <Button
        android:id="@+id/button_matrix_sdl_delay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/launch_matrix_screensaver_sdl_delay" />
    <Button
        android:id="@+id/button_raycaster_pitch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/launch_raycaster_pitch" />
</LinearLayout>
